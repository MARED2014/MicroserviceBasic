<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · PizzaPulse</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header class="topbar">
        <a class="brand" asp-controller="Menu" asp-action="Index">PizzaPulse</a>
        <nav>
            <a asp-controller="Menu" asp-action="Index">Menü</a>
            <a asp-controller="Cart" asp-action="Index">Sepet</a>
        </nav>
    </header>
    <main class="page">
        @if (TempData["Success"] is string success)
        {
            <div class="banner ok">@success</div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="banner err">@error</div>
        }
        @if (ViewBag.Error is string pageError)
        {
            <div class="banner err">@pageError</div>
        }
        @RenderBody()
    </main>
</body>
</html>
